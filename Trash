<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LANDFALL — Coming to Android</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy-deep: #050b14;
    --navy-panel: #0a1420;
    --navy-panel-2: #0d1b28;
    --teal: #2dd4c0;
    --teal-dim: rgba(45, 212, 192, 0.14);
    --danger: #e8483a;
    --ice: #c8e6eb;
    --text-body: #a9c2ca;
    --text-dim: #5a7480;
    --border: rgba(45, 212, 192, 0.18);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy-deep);
    color: var(--text-body);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 500;
    overflow-x: hidden;
    background-image:
      radial-gradient(ellipse at 20% 0%, rgba(45,212,192,0.06), transparent 55%),
      radial-gradient(ellipse at 90% 30%, rgba(232,72,58,0.05), transparent 45%);
  }

  a { color: inherit; }

  /* ── TOP BAR ─────────────────────────────────────────── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 5vw;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Russo One', sans-serif;
    font-size: 14px;
    letter-spacing: 0.14em;
    color: var(--text-dim);
  }
  .brand .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 8px var(--teal);
  }
  .topbar nav a {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 14px;
    letter-spacing: 0.06em;
    margin-left: 28px;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .topbar nav a:hover { color: var(--teal); }

  /* ── HERO ────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 40px;
    padding: 7vh 5vw 6vh;
    max-width: 1280px;
    margin: 0 auto;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--danger);
    text-transform: uppercase;
    border: 1px solid rgba(232,72,58,0.35);
    background: rgba(232,72,58,0.08);
    padding: 6px 12px;
    border-radius: 3px;
    margin-bottom: 22px;
  }
  .eyebrow .pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--danger);
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.7); }
  }

  h1.title {
    font-family: 'Russo One', sans-serif;
    font-size: clamp(52px, 8vw, 94px);
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: #f2fbfa;
    text-shadow: 0 0 40px rgba(45,212,192,0.25);
  }

  .tagline {
    margin-top: 22px;
    font-size: 20px;
    font-weight: 500;
    color: var(--text-body);
    max-width: 46ch;
    line-height: 1.5;
  }
  .tagline strong { color: var(--teal); font-weight: 700; }

  .hero-meta {
    margin-top: 32px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  .meta-item .k {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .meta-item .v {
    font-family: 'Russo One', sans-serif;
    font-size: 18px;
    color: var(--ice);
  }

  /* Signup */
  .signup {
    margin-top: 40px;
    display: flex;
    gap: 0;
    max-width: 440px;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    background: var(--navy-panel);
  }
  .signup input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 16px 18px;
    color: var(--ice);
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 600;
    outline: none;
  }
  .signup input::placeholder { color: var(--text-dim); }
  .signup button {
    background: var(--teal);
    border: none;
    color: #04211d;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 14px;
    padding: 0 22px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .signup button:hover { background: #45e8d5; }
  .signup-note { margin-top: 10px; font-size: 12px; color: var(--text-dim); }

  /* ── STORM CARD (hero visual) ────────────────────────── */
  .storm-visual {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 460px;
    margin: 0 auto;
  }
  .spiral {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg,
      #e8483a 0deg, #ffcf4d 40deg, #4ade80 90deg, #2dd4c0 150deg,
      #1a6e8c 220deg, #0d1b28 280deg, #e8483a 360deg);
    filter: blur(2px) saturate(1.15);
    opacity: 0.85;
    animation: spin 26s linear infinite;
    mask-image: radial-gradient(circle, black 62%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle, black 62%, transparent 100%);
  }
  .spiral::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 180deg,
      transparent 0deg, rgba(5,11,20,0.5) 60deg, transparent 140deg,
      rgba(5,11,20,0.4) 220deg, transparent 320deg);
    animation: spin 18s linear infinite reverse;
  }
  .eye {
    position: absolute; top: 50%; left: 50%;
    width: 14%; height: 14%;
    background: radial-gradient(circle, #dff8f5 0%, #8fd8cf 60%, #1a4a44 100%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 30px rgba(45,212,192,0.6);
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .storm-card {
    position: absolute;
    bottom: -6%;
    left: -8%;
    width: 78%;
    background: rgba(10, 20, 32, 0.92);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px 18px;
    backdrop-filter: blur(6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
  }
  .storm-card .label {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .storm-card .name {
    font-family: 'Russo One', sans-serif;
    font-size: 19px;
    color: #fff;
    margin: 2px 0 10px;
  }
  .stat-row { display: flex; gap: 22px; }
  .stat .label { margin-bottom: 3px; }
  .stat .val {
    font-family: 'Russo One', sans-serif;
    font-size: 15px;
    color: var(--teal);
  }
  .stat .val.danger { color: var(--danger); }

  /* ── FEATURES ─────────────────────────────────────────── */
  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 8vh 5vw;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
  }
  .section-head h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 28px;
    color: #f2fbfa;
  }
  .section-head span {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .action-card {
    background: var(--navy-panel);
    padding: 26px 24px;
    position: relative;
  }
  .action-card::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--teal);
  }
  .action-card .lv {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .action-card h3 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--ice);
    margin-bottom: 8px;
  }
  .action-card p {
    font-size: 14.5px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* ── TICKER ───────────────────────────────────────────── */
  .ticker-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: #0c1520;
    padding: 12px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker-track {
    display: inline-block;
    animation: ticker 42s linear infinite;
    font-size: 14.5px;
    color: var(--text-body);
  }
  .ticker-track span.sep { color: var(--teal); margin: 0 20px; }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── FOOTER ───────────────────────────────────────────── */
  footer {
    max-width: 1280px;
    margin: 0 auto;
    padding: 6vh 5vw 5vh;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  footer .fbrand {
    font-family: 'Russo One', sans-serif;
    font-size: 13px;
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }
  footer .fsocial a {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-left: 22px;
    transition: color 0.2s;
  }
  footer .fsocial a:hover { color: var(--teal); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 4vh; }
    .storm-visual { max-width: 320px; margin-top: 40px; }
    .signup { flex-direction: column; }
    .signup button { padding: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spiral, .spiral::after, .ticker-track, .eyebrow .pulse { animation: none !important; }
  }
</style>
</head>
<body>

  <div class="topbar">
    <div class="brand"><span class="dot"></span> FEICH13 STUDIOS</div>
    <nav>
      <a href="#features">Gameplay</a>
      <a href="#notify">Notify Me</a>
    </nav>
  </div>

  <div class="hero">
    <div>
      <div class="eyebrow"><span class="pulse"></span> Currently Forming</div>
      <h1 class="title">LANDFALL</h1>
      <p class="tagline">Track it. Steer it. Name it. <strong>LANDFALL</strong> is a hurricane simulator for Android — draw the track, manage the intensity, and see how much damage a single storm can really do.</p>

      <div class="hero-meta">
        <div class="meta-item">
          <div class="k">Platform</div>
          <div class="v">Android</div>
        </div>
        <div class="meta-item">
          <div class="k">Launch Window</div>
          <div class="v">Atlantic Season</div>
        </div>
        <div class="meta-item">
          <div class="k">Price</div>
          <div class="v">One-time purchase</div>
        </div>
      </div>

      <form class="signup" id="notify" onsubmit="return false;">
        <input type="email" placeholder="you@email.com" required>
        <button type="submit">Notify Me</button>
      </form>
      <div class="signup-note">No spam. One email, the day it launches.</div>
    </div>

    <div class="storm-visual">
      <div class="spiral"></div>
      <div class="eye"></div>
      <div class="storm-card">
        <div class="label">Storm</div>
        <div class="name">Hurricane Landfall</div>
        <div class="stat-row">
          <div class="stat">
            <div class="label" style="font-size:10px;color:#5a7480;">Category</div>
            <div class="val danger">5</div>
          </div>
          <div class="stat">
            <div class="label" style="font-size:10px;color:#5a7480;">Wind</div>
            <div class="val">184 mph</div>
          </div>
          <div class="stat">
            <div class="label" style="font-size:10px;color:#5a7480;">ETA</div>
            <div class="val">Soon</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section" id="features">
    <div class="section-head">
      <h2>Storm Actions</h2>
      <span>What you'll actually be doing</span>
    </div>
    <div class="action-grid">
      <div class="action-card">
        <div class="lv">Track</div>
        <h3>Draw the path</h3>
        <p>Every storm goes where you send it. One finger, one line, one landfall.</p>
      </div>
      <div class="action-card">
        <div class="lv">Intensify</div>
        <h3>Manage the conditions</h3>
        <p>Suppress shear, absorb heat, dive deeper — real atmospheric levers, real consequences.</p>
      </div>
      <div class="action-card">
        <div class="lv">React</div>
        <h3>Survive the Black Swans</h3>
        <p>Unpredictable events reshape every season. Some help. Most don't.</p>
      </div>
      <div class="action-card">
        <div class="lv">Score</div>
        <h3>Hit your targets</h3>
        <p>Cities across five ocean basins, each with their own value on the line.</p>
      </div>
    </div>
  </div>

  <div class="ticker-wrap">
    <div class="ticker-track" id="tickerTrack"></div>
  </div>

  <footer>
    <div class="fbrand">FEICH13 STUDIOS © 2026</div>
    <div class="fsocial">
      <a href="#">TikTok</a>
      <a href="#">YouTube</a>
      <a href="#">Google Play</a>
      <a href="privacy.html">Privacy Policy</a>
    </div>
  </footer>

<script>
  const lines = [
    "Hurricane Hunter makes TikTok in eyewall",
    "NHC briefing interrupted after reporter asks if the storm has a Spotify playlist",
    "Storm chasers descend despite NHC explicitly asking them not to",
    "King of Spain fails citizenship test",
    "Scottish man runs 240 miles in 6 hours, celebrates with black pudding",
    "Local hardware store sells out of plywood, enterprising teens sell cardboard at markup",
    "Dev log: five ocean basins, 630+ cities, still adding more",
  ];
  const track = document.getElementById('tickerTrack');
  const content = lines.join('<span class="sep">•</span>');
  track.innerHTML = content + '<span class="sep">•</span>' + content;
</script>

</body>
</html>
